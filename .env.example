# ARC-AGI-3 API Configuration
# Copy this file to .env and fill in your actual API key
ARC_API_KEY=your-arc-api-key-here

# Alternative API key variable name (for compatibility)
ANTHROPIC_API_KEY=your-api-key-here

# Database Configuration (optional)
# DATABASE_PATH=data/tabula_rasa.db

# Logging Configuration (optional)
# LOG_LEVEL=INFO
# LOG_FILE=training.log

# Training Configuration (optional)
# MAX_GAMES_PER_SESSION=100
# TRAINING_DURATION_HOURS=9

# Python Configuration
# Disable Python bytecode generation (__pycache__ directories)
PYTHONDONTWRITEBYTECODE=1